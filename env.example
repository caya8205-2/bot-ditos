# .env HANYA untuk credentials (dan path tool opsional).
# Semua pengaturan model, provider, vision, dan auto-chat ada di config.yaml.

# ── Discord ─────────────────────────────────────────────────────────────────
DISCORD_TOKEN=

# ── API key provider LLM ────────────────────────────────────────────────────
# Nama variabel di sini dirujuk dari config.yaml lewat field key_env.
NINER_API_KEY=
NINER_FALLBACK_API_KEY=
ZENMUX_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_BACKUP_1=
GROQ_API_KEY_BACKUP_2=

# ── LLM lokal (opsional, KoboldCpp biasanya tanpa key) ──────────────────────
LOCAL_LLM_API_KEY=

# ── API key layanan lain ────────────────────────────────────────────────────
GEMINI_API_KEY=
WEATHER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
CIVITAI_API_KEY=

# ── Path tool opsional ──────────────────────────────────────────────────────
INNERTUBE_BIN=
SPOTSTREAM_BIN=
BIREFNET_URL=

# ── Override opsional (biasanya tidak perlu) ─────────────────────────────────
# Lokasi file config kalau tidak di root project.
# BOT_CONFIG_PATH=
