GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_BACKUP_1=
GROQ_API_KEY_BACKUP_2=
DISCORD_TOKEN=
GEMINI_API_KEY=
WEATHER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
CIVITAI_API_KEY=
LOCAL_LLM_BASE_URL=http://127.0.0.1:5001/v1
LOCAL_LLM_MODEL=Qwen2-VL-2B-Instruct-Q8_0.gguf
LOCAL_LLM_TIMEOUT_MS=120000
LOCAL_LLM_FALLBACK_COOLDOWN_MS=300000
NINER_BASE_URL=
NINER_API_KEY=
NINER_MODEL=auto
# Model cadangan, dicoba sebelum jatuh ke Groq.
NINER_FALLBACK_MODEL=
# Provider fallback terpisah. Isi kalau model cadangan ada di endpoint lain.
# Kalau dikosongkan, model cadangan tetap dikirim ke NINER_BASE_URL.
NINER_FALLBACK_BASE_URL=
NINER_FALLBACK_API_KEY=
NINER_TIMEOUT_MS=120000
NINER_FALLBACK_COOLDOWN_MS=60000
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
LOCAL_LLM_INPUT_TOKEN_BUDGET=6000
PROMPT_METRICS_ENABLED=true

# Vision manager untuk GAMBAR dan OCR (provider OpenAI-compatible apa pun).
# Isi dengan 9router lokal, ZenMux, atau provider lain. Kalau kosong, gambar
# tidak bisa dianalisa saat model utama tidak vision-capable.
VISION_BASE_URL=
VISION_API_KEY=
# Kosongkan supaya model dipilih otomatis dari katalog /models berdasarkan
# kapabilitas vision yang sebenarnya. Isi untuk memaksa model tertentu.
VISION_MODEL=
# VISION_TIMEOUT_MS=60000
# VISION_MAX_DIMENSION=1024
# Batas minimum prompt_tokens; di bawah ini gambar dianggap tidak diproses.
# VISION_MIN_PROMPT_TOKENS=100
# Jumlah model yang dicoba kalau kandidat pertama ternyata tidak bisa gambar.
# VISION_MAX_ATTEMPTS=3

# Provider vision untuk VIDEO (dipakai hanya kalau model utama tidak bisa video).
# Contoh: ZenMux. Nama model diambil dari VISION_VIDEO_MODEL.
ZENMUX_BASE_URL=
ZENMUX_API_KEY=
VISION_VIDEO_MODEL=z-ai/glm-4.6v-flash-free
# Opsional: override nama var di atas.
# VISION_PROVIDER_BASE_URL=
# VISION_PROVIDER_API_KEY=
# VISION_VIDEO_TIMEOUT_MS=240000
# Batas unduh dari Discord (clip 30s ~50MB).
# VISION_VIDEO_DOWNLOAD_MAX_BYTES=104857600
# Target setelah kompresi (base64 membengkak ~33%).
# VISION_VIDEO_TARGET_BYTES=9437184
# VISION_VIDEO_MAX_DURATION_S=90
# VISION_VIDEO_MAX_HEIGHT=480
# TTL cache katalog model dari endpoint /models.
# MODEL_CATALOG_TTL_MS=1800000
